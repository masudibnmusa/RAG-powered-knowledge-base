# App
PORT=8000
ENV=development

# LLM
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# Vector DB
VECTOR_DB_PROVIDER=chroma
PINECONE_API_KEY=
PINECONE_ENV=
WEAVIATE_URL=
CHROMA_PERSIST_DIR=data/vector_db

# Embeddings
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=1536

# Connectors
GOOGLE_DRIVE_CREDENTIALS=
NOTION_API_KEY=
GITHUB_TOKEN=
CONFLUENCE_API_KEY=
SLACK_TOKEN=

# Sync
SYNC_INTERVAL_MINUTES=60
SYNC_STATE_DIR=data/sync_state

# Retrieval
RERANK_ENABLED=true
HYBRID_SEARCH_ALPHA=0.5